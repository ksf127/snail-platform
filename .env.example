# 复制为 .env 后按需修改；docker compose 会自动读取同目录 .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root123
DB_NAME=platform_db
DB_USERNAME=platform
DB_PASSWORD=platform123

# ---------- RabbitMQ ----------
RABBITMQ_USERNAME=platform
RABBITMQ_PASSWORD=platform123
RABBITMQ_VHOST=/

# ---------- MinIO ----------
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=platform123
MINIO_BUCKET=platform-artifacts

# ---------- 平台安全 ----------
# 生产环境必须替换：至少 32 字节随机字符串
JWT_SECRET=dev-only-jwt-secret-please-change-0123456789abcdef
# control 与 worker 共享的内部调用令牌
INTERNAL_TOKEN=dev-internal-token
# 构建变量 / 仓库 token 的 AES-256-GCM 密钥；留空时从 JWT_SECRET 派生
# 生产必须显式配置并备份，丢失后已有密文无法解密
PLATFORM_CRYPTO_KEY=
# 同一流水线允许排队的运行上限，超过后触发返回 409
MAX_QUEUED_PER_PIPELINE=3

# ---------- Gitea（可选）----------
GITEA_ROOT_URL=http://localhost:3000/
# 平台访问 Gitea 的地址；容器内使用服务名
GITEA_URL=http://gitea:3000
GITEA_TOKEN=
GITEA_ADMIN_USER=gitea_admin
GITEA_ADMIN_PASSWORD=gitea_admin123

# ---------- 构建执行器 ----------
EXECUTOR_DEFAULT=DOCKER
EXECUTOR_TIMEOUT_SECONDS=1800
# worker 工作目录在宿主机上的路径，必须与容器内路径一致，Docker 执行器才能挂载源码
WORKSPACE_HOST_DIR=./workspace

# ---------- Kubernetes（可选）----------
K8S_KUBECONFIG=
K8S_NAMESPACE=platform
K8S_GIT_IMAGE=alpine/git:latest
K8S_TOOL_IMAGE=alpine:3.20
K8S_WORKSPACE_SIZE=1Gi

# ---------- Jenkins（可选，配合 --profile jenkins）----------
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_JOB=
JENKINS_ADMIN_PASSWORD=admin123

# ---------- 前端 ----------
# 前端请求的后端地址；留空则使用同源 /api
VITE_API_BASE=http://localhost:8088
